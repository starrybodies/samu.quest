{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "saucy.samu.quest"
        }
      ],
      "dest": "/sacred-saucy.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "redbook.samu.quest"
        }
      ],
      "dest": "/redbook/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
